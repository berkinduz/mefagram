{
  "name": "mefagram",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4747",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4747",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "setup": "tsx scripts/setup.ts",
    "agent": "tsx scripts/agent.ts",
    "verify:integration": "tsx scripts/verify-integration.ts",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "schema:export": "tsx scripts/export-schema.ts",
    "postbuild": "node scripts/record-externals.mjs && node scripts/verify-bundle.mjs",
    "verify:installation": "tsx scripts/verify-installation.ts",
    "mefagram": "node bin/mefagram.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepare": "node scripts/copy-layout-worker.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "lucide-react": "1.68.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@next/env": "16.4.5",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "description": "Local diagram workspace for AI agents and human readers, with an MCP endpoint and portable data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berkinduz/mefagram.git"
  },
  "bugs": {
    "url": "https://github.com/berkinduz/mefagram/issues"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "bin": {
    "mefagram": "bin/mefagram.mjs"
  },
  "files": [
    "bin",
    "public",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/trace",
    "next.config.ts",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "diagram",
    "claude",
    "codex",
    "agents",
    "mermaid",
    "workflow"
  ]
}
