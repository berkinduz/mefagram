{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "mefagram"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "default": "",
          "type": "string",
          "maxLength": 12000
        },
        "tags": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "document": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "nodes": {
              "maxItems": 2000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "kind": {
                    "default": "step",
                    "type": "string",
                    "enum": [
                      "phase",
                      "step",
                      "decision",
                      "note",
                      "result"
                    ]
                  },
                  "description": {
                    "default": "",
                    "type": "string",
                    "maxLength": 12000
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 50000
                  },
                  "sources": {
                    "default": [],
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "url": {
                          "type": "string",
                          "maxLength": 2048,
                          "format": "uri"
                        }
                      },
                      "required": [
                        "label",
                        "url"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "tags": {
                    "default": [],
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "position": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "label",
                  "kind",
                  "description",
                  "notes",
                  "sources",
                  "tags"
                ],
                "additionalProperties": false
              }
            },
            "edges": {
              "maxItems": 6000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                  },
                  "label": {
                    "default": "",
                    "type": "string",
                    "maxLength": 160
                  },
                  "kind": {
                    "default": "flow",
                    "type": "string",
                    "enum": [
                      "flow",
                      "feedback",
                      "reference"
                    ]
                  }
                },
                "required": [
                  "id",
                  "source",
                  "target",
                  "label",
                  "kind"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schemaVersion",
            "nodes",
            "edges"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "description",
        "tags",
        "document"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "version",
    "source",
    "diagram"
  ],
  "additionalProperties": false
}
