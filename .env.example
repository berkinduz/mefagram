# Optional: copy this to .env.local before npm run setup.
# Blank secrets are generated on first setup; existing secrets are preserved.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
MEFAGRAM_SETUP_KEY=
MEFAGRAM_OWNER_EMAIL=owner@mefagram.local
# Bootstrap name only; does not rename an existing account.
# MEFAGRAM_OWNER_NAME=Your name
MEFAGRAM_DATA_DIR=.mefagram/db

# Set this for hosted Postgres. Mandatory on Vercel and Netlify.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Set true on any other stateless host to forbid local disk fallback.
# MEFAGRAM_REQUIRE_DATABASE_URL=true

# Optional, for agent CLI calls to another running installation:
# MEFAGRAM_URL=https://your-private-workspace.example
# MEFAGRAM_AGENT_TOKEN=read-from-your-secret-store
