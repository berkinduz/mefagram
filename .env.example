# npm run setup creates .env.local with random secrets and a private owner.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MEFAGRAM_SETUP_KEY=replace-with-another-random-secret-of-at-least-32-characters
MEFAGRAM_OWNER_EMAIL=you@example.com
MEFAGRAM_DATA_DIR=.mefagram/db

# Set this for hosted Postgres. It is mandatory on Vercel.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional, for agent CLI calls to another running installation:
# MEFAGRAM_URL=https://your-private-workspace.example
# MEFAGRAM_AGENT_TOKEN=read-from-your-secret-store
