# Optional: copy this to .env.local before npm run setup.
MEFAGRAM_DATA_DIR=.mefagram/db

# Optional: use a Postgres database instead of the local PGlite directory.
# DATABASE_URL=postgresql://user:password@127.0.0.1/database

# Optional, for agent CLI calls when the app runs on another port:
# MEFAGRAM_URL=http://127.0.0.1:4800
